# Example local env for frontend Next proxy
# Copy this to frontend/.env.local and fill with real values (do NOT commit secrets).

# Backend Python workflow endpoint (adjust if your backend runs on a different host/port)
NEXT_PUBLIC_PY_WORKFLOW_DOCX_URL=http://localhost:8000/api/workflow/docx

# Optional: idempotency key for testing
# X_IDEMPOTENCY_KEY=your-test-key

# Example placeholders for any secrets used by frontend (keep empty or set in .env.local only)
# OPENAI_API_KEY=your_openai_api_key_here
# OTHER_SECRET=your_other_secret_here
